{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "## Conventions\n\n- **Instants:** ISO-8601 UTC strings ending in `Z`, microsecond precision. Clients convert to the user's time zone.\n- **Money:** `{\"amount\": \"12.50\", \"currency\": \"USD\"}` (schema `Money`). `amount` is a decimal string in the currency's\n  minor units; do not do arithmetic on it as a floating-point number. Requests accept a string or a number and reject\n  unknown currencies and amounts with more decimal places than the currency allows.\n- **Errors:** `application/problem+json` (schema `Problem`) with a `code`. Branch on `code`; `detail` is English text\n  for developers.\n\n| `code` | Status | When |\n|---|---|---|\n| `INVALID_REQUEST` | 400 | Validation failure, unreadable body, malformed path variable. `errors[]` lists `{field, code, message}` |\n| `NOT_FOUND` | 404 | Unknown resource or path |\n| `INTERNAL_ERROR` | 500 | Unexpected failure |\n| Business codes | 4xx | Listed on each operation that can return them |\n| Other | 4xx | HTTP status name, e.g. `METHOD_NOT_ALLOWED` |\n\n`errors[].code` is the violated constraint (`NotBlank`, `Positive`, ...) or `InvalidValue` when the body could not be read.",
    "title" : "Etude API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/admin/v1/products" : {
      "post" : {
        "operationId" : "registerProduct",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RegisterProductRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProductResponse"
                }
              }
            },
            "description" : "Created",
            "headers" : {
              "Location" : {
                "description" : "URI of the created resource",
                "schema" : {
                  "type" : "string",
                  "format" : "uri-reference"
                }
              }
            }
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Error. Branch on `code`."
          }
        },
        "summary" : "Register a product",
        "tags" : [ "Products" ]
      }
    },
    "/admin/v1/stocks" : {
      "post" : {
        "operationId" : "registerStock",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RegisterStockRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/StockResponse"
                }
              }
            },
            "description" : "Created",
            "headers" : {
              "Location" : {
                "description" : "URI of the created resource",
                "schema" : {
                  "type" : "string",
                  "format" : "uri-reference"
                }
              }
            }
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "allOf" : [ {
                    "$ref" : "#/components/schemas/Problem"
                  }, {
                    "type" : "object",
                    "properties" : {
                      "code" : {
                        "type" : "string",
                        "enum" : [ "PRODUCT_NOT_FOUND", "INVALID_REQUEST" ]
                      }
                    }
                  } ]
                }
              }
            },
            "description" : "Error codes: PRODUCT_NOT_FOUND, INVALID_REQUEST"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "allOf" : [ {
                    "$ref" : "#/components/schemas/Problem"
                  }, {
                    "type" : "object",
                    "properties" : {
                      "code" : {
                        "type" : "string",
                        "enum" : [ "STOCK_ALREADY_REGISTERED" ]
                      }
                    }
                  } ]
                }
              }
            },
            "description" : "Error codes: STOCK_ALREADY_REGISTERED"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Error. Branch on `code`."
          }
        },
        "summary" : "Register stock for a product",
        "tags" : [ "Stocks" ]
      }
    },
    "/admin/v1/stocks/{productId}" : {
      "get" : {
        "operationId" : "getStock",
        "parameters" : [ {
          "in" : "path",
          "name" : "productId",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/StockResponse"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Error. Branch on `code`."
          }
        },
        "summary" : "Get the stock of a product",
        "tags" : [ "Stocks" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "FieldViolation" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : [ "string", "null" ]
          },
          "field" : {
            "type" : [ "string", "null" ]
          },
          "message" : {
            "type" : [ "string", "null" ]
          }
        }
      },
      "Money" : {
        "type" : "object",
        "properties" : {
          "amount" : {
            "type" : "string",
            "description" : "Decimal string in the currency's minor units",
            "example" : "12.50"
          },
          "currency" : {
            "type" : "string",
            "description" : "ISO 4217 currency code",
            "example" : "USD"
          }
        },
        "required" : [ "amount", "currency" ]
      },
      "Problem" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string",
            "description" : "Error code to branch on",
            "example" : "INVALID_REQUEST"
          },
          "detail" : {
            "type" : [ "string", "null" ]
          },
          "errors" : {
            "type" : [ "array", "null" ],
            "description" : "Field errors of an INVALID_REQUEST",
            "items" : {
              "$ref" : "#/components/schemas/FieldViolation"
            }
          },
          "instance" : {
            "type" : [ "string", "null" ]
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "code", "status", "title" ]
      },
      "ProductResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "price" : {
            "$ref" : "#/components/schemas/Money"
          },
          "salesStatus" : {
            "type" : "string",
            "enum" : [ "ON_SALE", "SUSPENDED" ]
          }
        },
        "required" : [ "id", "name", "price", "salesStatus" ]
      },
      "RegisterProductRequest" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          },
          "price" : {
            "$ref" : "#/components/schemas/Money"
          }
        },
        "required" : [ "name", "price" ]
      },
      "RegisterStockRequest" : {
        "type" : "object",
        "properties" : {
          "productId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "quantity" : {
            "type" : "integer",
            "format" : "int32",
            "minimum" : 0
          }
        },
        "required" : [ "productId", "quantity" ]
      },
      "StockResponse" : {
        "type" : "object",
        "properties" : {
          "productId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "quantity" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "productId", "quantity" ]
      }
    }
  }
}
